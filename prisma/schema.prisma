generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id           String       @id @default(uuid())
  clerkId      String       @unique
  firstName    String
  lastName     String
  userName     String
  age          Int
  email        String
  profileImage String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  products     Product[]
  favorites    Favorite[]
  promotion    Promotion[]
  Categories   Categories[]
}

model Categories {
  id        String    @id @default(cuid())
  profileId String
  name      String
  createdAt DateTime  @default(now())
  Profile   Profile   @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
  products  Product[]
}

model Product {
  id            String      @id @default(uuid())
  name          String
  description   String
  category      String
  image         String
  retail        Int
  wholesale     Int
  perPieceCrate Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  profile       Profile     @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
  profileId     String
  favorites     Favorite[]
  Categories    Categories? @relation(fields: [categoriesId], references: [id])
  categoriesId  String?
}

model Promotion {
  id          String   @id @default(uuid())
  name        String
  description String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile       Profile     @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
  profileId     String
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
  profileId String

  products  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([profileId, productId])
}
